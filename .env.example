# Copy to .env and fill in. NEVER commit .env.
PRIVATE_KEY=0xyourdeployerprivatekeyhere
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app
USDC_ADDRESS=0xresolvedaftercheck
# Services with amount > ACK_THRESHOLD (USDC micro-units, 6dp) cannot be optimistically
# released — they require payer ack or arbitrator resolution. Default 50.00 USDC.
# 0 = strict mode (no optimistic release for any service).
ACK_THRESHOLD=50000000
